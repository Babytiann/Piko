{
  "name": "piko",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.30.2",
  "scripts": {
    "start": "concurrently \"pnpm --filter backend dev\" \"cd frontend && expo run:ios\"",
    "build": "pnpm --filter backend build",
    "prepare": "husky"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "prettier-plugin-tailwindcss": "^0.5.11"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,css,md,html}": "prettier --write"
  },
  "engines": {
    "node": ">=18"
  }
}
